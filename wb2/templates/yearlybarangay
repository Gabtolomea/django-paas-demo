<div>
<table>
    <thead>
        <tr>
            <th>Barangay</th>
            <th>Total Usage (Cubic Meter)</th>
            <th>Total Receivable</th>
            <th>Total Collection</th>
            <th>Collection Rate</th>
        </tr>
    </thead>

<tbody>
    {% for br in br %}
