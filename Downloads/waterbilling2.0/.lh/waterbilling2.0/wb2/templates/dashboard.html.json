            "date": 1758594497033,
            "name": "Commit-0",
            "content": "{% load static %}\n{% static \"images\" as images %}\n{% load active_link_tags %}\n<!DOCTYPE html>\n<html lang=\"en\" >\n\n<head>\n    <title>\n        {% block title %}\n        {% endblock title %}\n    </title>\n    <link rel=\"icon\" href=\"{% static 'images/logo.png' %}\" type=\"images/png\" sizes=\"16x16\">\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"{% static 'dashboard.css'%}\">\n    <link rel=\"stylesheet\" href=\"{% static 'bootstrap.min.css' %}\">\n    <script src=\"{% static 'html2pdf.bundle.min.js'%}\"> </script>\n    <script type=\"text/javascript\" src=\"{% static 'jsPDF/cdnjs/jspdf.min.js' %}\"></script>\n    <script src=\"{% static 'chart.js' %}\"> </script>\n\n    {% block style %}\n    {% endblock style %}\n    <style>\n        .img-fluid {\n            border-radius: 50%;\n            width: 150px;\n            height: 150px;\n        }\n\n        .fa-2x {\n            font-size: 23px;\n        }\n\n        .icons:hover path {\n            fill: #004757\n        }\n\n        .icons:hover circle {\n            fill: #004757\n        }\n        a{\n            text-decoration: none;\n        }\n        \n    </style>\n</head>\n\n<body onload=\"hiposon()\">\n    <div class=\"modal fade show\" id=\"exampleModal\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"exampleModalLabel\"\n        aria-hidden=\"true\">\n        <div class=\"modal-dialog\" role=\"document\">\n            <div class=\"modal-content\">\n                <div class=\"modal-header bg-dark border-0\">\n                    <span class=\"mobile_header_font\" style=\"color:white;font-weight: 700;\">\n                        WATER BILLING\n                        <span class=\"station\" style=\"color: #63CDD7;\">SYSTEM</span>\n                    </span>\n                    <button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-label=\"Close\">\n                        <span aria-hidden=\"true\">&times;</span>\n                    </button>\n                </div>\n                <div class=\"modal-body sidebar w-100\">\n                    <div class=\"user_info\" style=\"margin-top: 0;\">\n                        <img src=\"{% static 'svgs/payments.svg' %}\" alt=\"\">\n                        <p style=\"font-size: 30px\">{{user}}</p>\n                    </div>\n                    <ul class=\"list-unstyled\" style=\"padding-left: 30px;\">\n                        <li class=\"modal_side_nav_li\">\n                            <a class=\"modal_side_nav_li_text\" href=\"{% url 'bills_list' %}\"\n                                style=\"color: white; text-decoration: none;\">\n                                <svg class=\"icons\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"white\" height=\"48\"\n                                    width=\"48\">\n                                    <path\n                                        d=\"M5.55 41.15q-1.95 0-3.325-1.375Q.85 38.4.85 36.45V14h4.7v22.45H40v4.7Zm7.2-7.15q-2 0-3.375-1.375T8 29.25v-18.8Q8 8.5 9.375 7.1q1.375-1.4 3.375-1.4h29.7q1.95 0 3.325 1.4 1.375 1.4 1.375 3.35v18.8q0 2-1.375 3.375T42.45 34Zm4.4-4.15q0-2.1-1.45-3.55-1.45-1.45-3.55-1.45v5Zm20.85 0h5v-5q-2.1 0-3.55 1.45Q38 27.75 38 29.85Zm-10.45-4q2.5 0 4.25-1.75t1.75-4.25q0-2.5-1.75-4.25t-4.25-1.75q-2.5 0-4.25 1.75t-1.75 4.25q0 2.5 1.75 4.25t4.25 1.75Zm-15.4-11q2.1 0 3.55-1.475 1.45-1.475 1.45-3.525h-5Zm30.85 0v-5h-5q0 2.05 1.45 3.525T43 14.85Z\" />\n                                </svg>\n                                <span class=\"sidenav_text\">Billing</span>\n                            </a>\n                        </li>\n                        <li class=\"modal_side_nav_li\">\n                            <a class=\"modal_side_nav_li_text\" href=\"{% url 'meterreading' %}\"\n                                style=\"color: white; text-decoration: none \">\n                                <i id=\"con\" class=\"fa fa-tachometer fa-2x\"></i>\n                                <span class=\"sidenav_text\">Meter Reading</span>\n                            </a>\n                        </li>\n                        <!--Added by Kathrina Bandajon November 26, 2024 || ID: AllPaid2611-->\n                        <li class=\"modal_side_nav_li\">\n                            <a class=\"modal_side_nav_li_text\" href=\"{% url 'consumer_list' %}\"\n                                style=\"color: white; text-decoration: none\">\n                                <i class=\"fa-solid fa-user fa-2x\"></i>\n                                <span class=\"sidenav_text\">Consumers</span>\n                            </a>\n                        </li>\n                        <li class=\"modal_side_nav_li {% active_link 'reports' 'active' %}\">\n                            <a class=\"modal_side_nav_li_text\" href=\"{% url 'reports' %}\"\n                                style=\"color: white; text-decoration: none\">\n                                <i class=\"fa fa-line-chart fa-2x\"></i>\n                                <span class=\"sidenav_text\">Reports</span>\n                            </a>\n                        </li>\n                            <a class=\"modal_side_nav_li_text\" href=\"{% url 'unsettled_bills' %}\"\n                                style=\"color: white; text-decoration: none\">\n                                <i class=\"fa fa-line-chart fa-2x\"></i>\n                                <span class=\"sidenav_text\">Unsettled Bills</span>\n                            </a>\n                        </li>\n                        <!--Added by Zel 02082025-->\n                        <li class=\"modal_side_nav_li\">\n                            <a class=\"modal_side_nav_li_text\" href=\"{% url 'delinquent_accounts' %}\" style=\"color: white; text-decoration: none\">\n                                <i class=\"fa-solid fa-user fa-2x\"></i>\n                                <span class=\"sidenav_text\">Delinquent</span>\n                            </a>\n                        </li>\n                        <!--Added by Zel 02082025-->\n                        <li class=\"modal_side_nav_li\">\n                            <a class=\"modal_side_nav_li_text\" href=\"{% url 'sysuser' %}\"\n                                style=\"color: white; text-decoration: none\">\n                                <i class=\"fa-solid fa-user-group fa-2x\"></i>\n                                <span class=\"sidenav_text\"> System Users</span>\n                            </a>\n                        </li>\n                        <li class=\"modal_side_nav_li\">\n                            <a class=\"modal_side_nav_li_text\" href=\"{% url 'settings' %}\"\n                                style=\"color: white; text-decoration: none\">\n                                <i class=\"fa-sharp fa-solid fa-gears fa-2x\"></i>\n                                <span class=\"sidenav_text\">Settings</span>\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </div>\n    <header>\n        {% for message in messages %}\n        <div id=\"login\" class=\"message position-absolute start-50 translate-middle mt-5 alert alert-{% if message.tags == 'error' %}danger{% else %}{{message.tags}}{% endif %} alert-dismissible\">\n            <strong>{{message.tags|title}}!</strong> {{message}}\n            <button type=\"button\" class=\"btn-close btn-sm\" style=\"height: 22px;\" data-bs-dismiss=\"alert\" aria-label=\"Close\"></button>\n        </div>\n        {% endfor %}\n\n        <div class=\"row w-100 m-auto \" style=\"height: 100%; align-content: center; font-weight: 700;\" id=\"myHeader\">\n            <div class=\"col-sm-8 col-md-8 col-lg-8;\" style=\"font-size: 20px; white-space: nowrap;\">\n                <button class=\"header_toggle\" onclick=\"first_toggle()\" id=\"first_toggle\" >\n                    <img style=\"width: 30px;\"\n                        src=\"{% static '/images/reorder_FILL1_wght700_GRAD0_opsz48.svg' %}\" />\n                    </button>\n                <button class=\"header_toggle\" onclick=\"second_toggle()\" id=\"second_toggle\" >\n                    <img style=\"width: 30px;\"\n                        src=\"{% static '/images/reorder_FILL1_wght700_GRAD0_opsz48.svg' %}\" />\n                    </button>\n                <button type=\"button\" class=\"header_toggle\" id=\"third_toggle\"  data-toggle=\"modal\" \n                    data-target=\"#exampleModal\">\n                    <img style=\"width: 30px;\"\n                        src=\"{% static '/images/reorder_FILL1_wght700_GRAD0_opsz48.svg' %}\" />\n                    </button>\n                <span class=\"mobile_header_font\" style=\"padding-left:10px; color:white\">WATER BILLING <span\n                        class=\"station\" style=\"color: #63CDD7;\">SYSTEM</span></span>\n            </div>\n\n            <div class=\"mobile_header_nav col-sm-4 col-md-4 col-lg-4\" style=\"text-align: right;\" id=\"mobile_header_nav\">\n                {% if is_issues %}\n                        <a class=\"me-5\" style=\"cursor: pointer;\" title=\"Notifications\" href=\"{% url 'issues' %}\">\n                            <img src=\"{% static 'images/issue_icon.svg' %}\"/>\n                        </a>\n                {% endif %}\n\n                <a class=\"me-5\" style=\"cursor: pointer;\" title=\"Sign out\" href=\"{% url 'signout' %}\">\n                    <img src=\"{% static '/images/logout_FILL0_wght500_GRAD200_opsz24.svg' %}\" />\n                </a>\n            </div>\n        </div>\n    </header>\n    <div class=\"sidebar \" style=\" height: auto !important; min-height: 100%; \" id=\"side_nav\">\n        <div class=\"user_info\">\n            <img class=\"img-fluid\" src=\"{{images}}/{{user.profilepic}}\">\n            <p style=\"font-size: 30px; margin-left: auto;\">{{user}}</p>\n        </div>\n\n        <ul class=\"list-unstyled\" style=\"margin-top: 30px; margin-left: -72px;\">\n\n            {% if request.user.is_teller or request.user.is_supervisor %}\n            <a  class=\"icons\" href=\"{% url 'bills_list' %}\" style=\"color: white; text-decoration: none;\" title=\"Payment\">\n                <li class=\"side_nav_li {% active_link 'bills_list' 'active' %}\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"white\" viewBox=\"0 0 48 48\"\n                        style=\"width: 13%;\">\n                        <path\n                            d=\"M5.55 41.15q-1.95 0-3.325-1.375Q.85 38.4.85 36.45V14h4.7v22.45H40v4.7Zm7.2-7.15q-2 0-3.375-1.375T8 29.25v-18.8Q8 8.5 9.375 7.1q1.375-1.4 3.375-1.4h29.7q1.95 0 3.325 1.4 1.375 1.4 1.375 3.35v18.8q0 2-1.375 3.375T42.45 34Zm4.4-4.15q0-2.1-1.45-3.55-1.45-1.45-3.55-1.45v5Zm20.85 0h5v-5q-2.1 0-3.55 1.45Q38 27.75 38 29.85Zm-10.45-4q2.5 0 4.25-1.75t1.75-4.25q0-2.5-1.75-4.25t-4.25-1.75q-2.5 0-4.25 1.75t-1.75 4.25q0 2.5 1.75 4.25t4.25 1.75Zm-15.4-11q2.1 0 3.55-1.475 1.45-1.475 1.45-3.525h-5Zm30.85 0v-5h-5q0 2.05 1.45 3.525T43 14.85Z\" />\n                    </svg>\n                    <span style=\"    padding-left: 20px; font-size: 20px;\">Billing</span>\n                </li>\n            </a>\n            {% endif %}\n\n            {% if request.user.is_teller or request.user.is_reader or request.user.is_supervisor %}\n            <a title=\"Input and Bulk Reading\" class=\"icons\" href=\"{% url 'meterreading' %}\" style=\"color: white; text-decoration: none \">\n                <li class=\"side_nav_li {% active_link 'meterreading' 'active' %}\">\n                    <svg fill=\"white\"  viewBox=\"0 0 1024 1024\" version=\"1.1\"\n                        xmlns=\"http://www.w3.org/2000/svg\" style=\"width: 13%;\">\n                        <path\n                            d=\"M511.61 909.48c-219.28 0-397.69-178.41-397.69-397.69S292.33 114.1 511.61 114.1 909.3 292.51 909.3 511.79c0 13.74 11.12 24.86 24.86 24.86s24.86-11.12 24