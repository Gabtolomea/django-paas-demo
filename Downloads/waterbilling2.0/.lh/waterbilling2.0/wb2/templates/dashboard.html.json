/ul>\n    </div>\n    <div class=\"container-fluid main_content\" id=\"main_content\">\n        {% block billslist %}\n        {% endblock billslist %}\n        {% block discount %}\n        {% endblock discount %}\n        {% block reports %}\n        {% endblock reports %}\n        {% block ledger %}\n        {% endblock ledger%}\n        {% block meterreading %}\n        {% endblock meterreading%}\n        {% block bills_list %}\n        {% endblock bills_list %}\n        {% block consumer_list %}\n        {% endblock consumer_list %}\n        {% block sysuser %}\n        {% endblock sysuser %}\n        {% block consumercreation %}\n        {% endblock consumercreation %}\n        {% block deleteUser %}\n        {% endblock deleteUser %}\n        {% block registration %}\n        {% endblock registration %}\n        {% block waterusage %}\n        {% endblock waterusage %}\n        {% block unsettled_bills %}\n        {% endblock unsettled_bills %}\n        {% block view_unsettled_bills %}\n        {% endblock view_unsettled_bills %}\n        {% block delinquent_accounts %}\n        {% endblock delinquent_accounts %}\n        {% block delinquent_months %}\n        {% endblock delinquent_months%}        \n        {% block sysuserupdate %}\n        {% endblock sysuserupdate %}\n        {% block settingspage %}\n        {% endblock settingspage %}\n        {% block revenue_report %}\n        {% endblock revenue_report %}\n        {% block usage_report_data %}\n        {% endblock usage_report_data %}\n        {% block bill %}\n        {% endblock bill %}\n        {% block new_contype %}\n        {% endblock new_contype %}\n        {% block view_barangay %}\n        {% endblock view_barangay %}\n\n\n        {% block bulkreading %}\n        {% endblock bulkreading %}\n\n\n\n\n        {% block userprof %}\n        {% endblock userprof %}\n        {% block viewprof %}\n        {% endblock viewprof %}\n        {% block penalties %}\n        {% endblock penalties %}\n        {% block stopmeter %}\n        {% endblock stopmeter %}\n\n        {% block additionalfeeslist %}\n        {% endblock additionalfeeslist %}\n\n        {% block conmon_sumary %}\n        {% endblock conmon_sumary %}\n\n\n        {% block payment_history%}\n        {% endblock payment_history %}\n        {% block consumption%}\n        {% endblock consumption %}\n        {% block exemptions %}\n        {% endblock exemptions %}\n        {% block issues %}\n        {% endblock issues  %}\n        {% block issue_details %}\n        {% endblock issue_details  %}\n\n        {% block record_list %}\n        {% endblock record_list %}\n        {% block billreportcopy %}\n        {% endblock billreportcopy %}\n        {% block monthly_collections %}\n        {% endblock monthly_collections %}\n        \n    </div>\n\n    <script>\n        // this is for hiposon ang sidebar\n        // hipos = {% if hipos %}true{% else %}false{% endif %}\n        // pagelinks = document.getElementsByClassName(\"page-links\");\n        // function hiposon(){\n        //     if(hipos){\n        //         document.getElementById(\"first_toggle\").style.display = \"none\";\n        //         document.getElementById(\"second_toggle\").style.display = \"none\";\n        //         document.getElementById(\"third_toggle\").style.display = \"initial\";\n        //         document.getElementById(\"mobile_header_nav\").style.display = \"none\";\n        //         document.getElementById(\"side_nav\").classList.remove(\"sidebar\");\n        //         document.getElementById(\"side_nav\").classList.add(\"remove_sidebar2\");\n        //         document.getElementById(\"main_content\").classList.remove(\"main_content\");\n        //         document.getElementById(\"main_content\").classList.add(\"remove_main_content\");\n        //         for(i=0;i<pagelinks.length;i++){\n        //             pagelinks[i].href += \"&sidebar=False\"\n        //         }\n        //     }\n        // }\n        function media_query_720(screen_size) {\n            if (screen_size.matches) {\n                document.getElementById(\"first_toggle\").style.display = \"none\";\n                document.getElementById(\"second_toggle\").style.display = \"none\";\n                document.getElementById(\"third_toggle\").style.display = \"initial\";\n                document.getElementById(\"mobile_header_nav\").style.display = \"none\";\n                document.getElementById(\"side_nav\").classList.remove(\"sidebar\");\n                document.getElementById(\"side_nav\").classList.add(\"remove_sidebar\");\n                document.getElementById(\"main_content\").classList.remove(\"main_content\");\n                document.getElementById(\"main_content\").classList.add(\"remove_main_content\");\n                hiposon()\n            } else {\n                document.getElementById(\"first_toggle\").style.display = \"initial\";\n                document.getElementById(\"second_toggle\").style.display = \"none\";\n                document.getElementById(\"third_toggle\").style.display = \"none\";\n                document.getElementById(\"mobile_header_nav\").style.display = \"initial\";\n                document.getElementById(\"side_nav\").classList.add(\"sidebar\");\n                document.getElementById(\"side_nav\").classList.remove(\"remove_sidebar\");\n                document.getElementById(\"main_content\").classList.add(\"main_content\");\n                document.getElementById(\"main_content\").classList.remove(\"remove_main_content\");\n                hiposon()\n\n            }\n        }\n        var screen_size = window.matchMedia(\"(max-width: 720px)\");\n        media_query_720(screen_size);\n        screen_size.addListener(media_query_720);\n        hiposon()\n        function first_toggle() {\n            document.getElementById(\"first_toggle\").style.display = \"none\";\n            document.getElementById(\"second_toggle\").style.display = \"initial\";\n            document.getElementById(\"side_nav\").classList.remove(\"sidebar\");\n            document.getElementById(\"side_nav\").classList.add(\"remove_sidebar\");\n            document.getElementById(\"main_content\").classList.remove(\"main_content\");\n            document.getElementById(\"main_content\").classList.add(\"remove_main_content\");\n            for(i=0;i<pagelinks.length;i++){\n                pagelinks[i].href += \"&sidebar=False\"\n            }\n        }\n        function second_toggle() {\n            document.getElementById(\"first_toggle\").style.display = \"initial\";\n            document.getElementById(\"second_toggle\").style.display = \"none\";\n            document.getElementById(\"side_nav\").classList.add(\"sidebar\");\n            document.getElementById(\"side_nav\").classList.remove(\"remove_sidebar\");\n            document.getElementById(\"main_content\").classList.add(\"main_content\");\n            document.getElementById(\"main_content\").classList.remove(\"remove_main_content\");\n            for(i=0;i<pagelinks.length;i++){\n                pagelinks[i].href = pagelinks[i].href.replace(\"&sidebar=False\",'')\n            }\n        }\n        $(document).ready(function () {\n            let menuScrollTimer = null;\n            $(\".nav a\").click(function (e) {\n                e.preventDefault();\n                if (menuScrollTimer === null) {\n                    $('.nav a.active').removeClass('active');\n                    $(this).addClass('active');\n                    let target = $(this).attr('href');\n                    $('html, body').animate({ scrollTop: $(target).offset().top - 100 }, 1050);\n                    menuScrollTimer = setTimeout(function () {\n                        clearTimeout(menuScrollTimer);\n                        menuScrollTimer = null;\n                    }, 1050);\n                }\n            });\n\n            $(window).scroll(function (e) {\n                if (menuScrollTimer === null) {\n                    let windowTop = $(this).scrollTop();\n\n                    $('.nav a').each(function (event) {\n                        if (windowTop >= $($(this).attr('href')).offset().top - 100) {\n                            $('.nav .active').removeClass('active');\n                            $(this).addClass('active');\n                        }\n                    });\n                }\n            });\n        });\n    </script>\n\n    <script src=\"{% static 'jquery/jquery.js' %}\"></script>\n    <script src=\"{% static 'bootstrap.min.js' %}\"></script>\n    <script src=\"{% static 'popper.min.js' %}\"></script>\n\n    <script>\n        var login = document.getElementById('login');\n        setTimeout(function closeModal() {\n            login.classList.add(\"op-0\")\n        }, 3000)\n        setTimeout(function dispnone() {\n            login.style.display = \"none\"\n        }, 4000)\n    </script>\n\n    {% block script %}\n    {% endblock script %}\n</body>\n\n</html>"
        }
